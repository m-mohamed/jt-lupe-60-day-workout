{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jt-lupe-workout",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],

  // `npm run assets` copies only the five public PWA files from the repository root
  // for Wrangler, keeping its watcher away from cloud/node_modules and the test tree.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // One SQLite-backed Durable Object per person. `new_sqlite_classes` is what
  // selects the SQLite storage backend rather than the older key/value one.
  "durable_objects": {
    "bindings": [
      { "name": "USER_STORE", "class_name": "UserStore" },
      { "name": "TRAINING_AGENT", "class_name": "TrainingAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserStore"] },
    { "tag": "v2", "new_sqlite_classes": ["TrainingAgent"] }
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1, "persist": true }
  },

  "vars": {
    // Filled in after Access is enabled — see cloud/README.md.
    // ACCESS_TEAM_DOMAIN example: "mnfstlabs.cloudflareaccess.com"
    "ACCESS_TEAM_DOMAIN": "jt-lupe-workout-cloud.cloudflareaccess.com",
    "ACCESS_AUD": "42312f685967edcc867d173097d806bbb876d2e8df99fc85d9b282c6866588c1"
  }
}
